# Copy this file to .env and fill in the values before running docker compose up

# Image tag to pull (e.g. fth-docker-collect, latest, 25.10.0)
TAG=latest

# Timezone
TZ=America/Toronto

# Set to true to enable debug logging in entrypoint scripts
DEBUG=false

# Gorgone poller settings
POLLER_ID=3
CENTRAL_ADDRESS=10.0.0.1
CENTRAL_PORT=443
GORGONE_TOKEN=change_me

# Centreon web API credentials (used to fetch engine-context.json at startup)
WEB_API_USERNAME=admin
WEB_API_PASSWORD=change_me
