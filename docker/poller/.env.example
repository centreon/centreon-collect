# Copy this file to .env and fill in the values before running `docker compose up`.

# Image tag to pull (e.g. 25.10.0, latest, MON-196928-gorgone-installation-script-docker-compose)
TAG=latest

# Timezone applied inside the container
TZ=UTC

# Set to true (or 1) to enable verbose entrypoint logging (set -x)
DEBUG=false

# --- Poller identity (provided by the Centreon GUI when adding a poller) ---

# Unique poller identifier — must match the value declared in Centreon Web
UUID=1234-abcd

# Human-readable poller name shown in Centreon Web
NAME=paris-edge-01

# Authentication token for the pullwss connection to the central gorgone
POLLER_TOKEN=change_me

# Central server URL — hostname or IPv4, optional :port and scheme
# (cloud.centreon.com, 192.168.1.10:8086, https://central.example.com)
CENTRAL_URL=cloud.centreon.com

# --- Engine secrets (written to /etc/centreon-engine/engine-context.json) ---
APP_SECRET=change_me
SALT=change_me
