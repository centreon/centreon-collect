{
  "permissions": {
    "deny": [
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(git push *--no-verify*)",
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)"
    ],
    "ask": [
      "Edit(./AGENTS.md)",
      "Edit(./CLAUDE.md)",
      "Edit(./**/CLAUDE.md)",
      "Edit(./ARCHITECTURE.md)",
      "Edit(./docs/**)",
      "Edit(./.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/component-context.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
