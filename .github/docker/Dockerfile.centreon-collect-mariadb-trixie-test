ARG REGISTRY_URL

FROM ${REGISTRY_URL}/debian:trixie

RUN --mount=type=bind,src=.,dst=/tmp/collect bash -e <<EOF

apt-get update

apt-get -y install \
    curl \
    dsniff \
    g++ \
    gcc \
    gdb \
    git \
    iptables \
    libhttp-daemon-ssl-perl \
    libjson-perl \
    liblua5.4 \
    libmariadb3 \
    locales \
    mariadb-server \
    openssh-server \
    perl-base \
    psmisc \
    python3 \
    python3-dev \
    python3-pip \
    rrdcached \
    rrdtool \
    strace \
    tcpdump \
    sudo \
    zstd

apt-get clean

echo -e '[mysqld]\nskip_ssl\n[client]\nssl=false' > /etc/mysql/mariadb.conf.d/99-disable-ssl.cnf

localedef -i en_US -c -f UTF-8 -A /usr/share/locale/locale.alias en_US.UTF-8

echo "install python virtual env"
apt-get install -y python3-venv
python3 -m venv /.venv
source /.venv/bin/activate

echo "install robot and dependencies"
/.venv/bin/pip3 install -U -r /tmp/collect/tests/requirements.txt

cd /tmp/collect

.github/scripts/collect-prepare-test-robot.sh mariadb

apt-get remove -y gcc g++ python3-dev
apt-get autoremove -y

apt-get clean

EOF

