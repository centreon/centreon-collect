#!/bin/sh
# filepath: /usr/local/bin/service

SERVICE="$2"
ACTION="$1"

GRPC_SIGNAL="/usr/local/lib/centreon-gorgone/grpc-signal.pl"
ENGINE_GRPC_PORT=50155

case "$SERVICE" in
  centengine)
    case "$ACTION" in
      reload)
        # RESTART signal = SIGHUP equivalent (config reload, process stays up)
        # EngineSignalProcess{process: RESTART} - proto3 default enum value
        # (0) is omitted on the wire, so the request body is empty.
        perl "$GRPC_SIGNAL" "$SERVICE" "$ENGINE_GRPC_PORT" \
          /com.centreon.engine.Engine/SignalProcess
        exit $?
        ;;
      restart)
        # SHUTDOWN signal — Docker restart:always/unless-stopped brings the container back
        # EngineSignalProcess{process: SHUTDOWN} -> field 1 (varint) = 1 -> 0x08 0x01
        perl "$GRPC_SIGNAL" "$SERVICE" "$ENGINE_GRPC_PORT" \
          /com.centreon.engine.Engine/SignalProcess 0801
        exit $?
        ;;
      *)
        echo "Unsupported action: $ACTION"
        exit 1
        ;;
    esac
    ;;
  cbd)
    case "$ACTION" in
      restart|reload)
        curl -sf -X POST "http://$SERVICE:8000/$ACTION"
        exit $?
        ;;
      *)
        echo "Unsupported action: $ACTION"
        exit 1
        ;;
    esac
    ;;
  *)
    echo "Unsupported service: $SERVICE"
    exit 1
    ;;
esac
