// Determines whether a wizard page should be skipped based on its PageID.
// Skips Config and Encryption pages if 'agent' component is not selected.
// Skips Download page if 'plugins' component is not selected.
// Returns True to skip the page, False otherwise.
function ShouldSkipPage(PageID: Integer): Boolean;
begin
  if (PageID = ConfigPage.ID) or (PageID = EncryptionPage.ID) then
    Result := not WizardIsComponentSelected('agent')
  else if PageID = DownloadPage.ID then
    Result := not WizardIsComponentSelected('plugins')
  else
    Result := False;
end;
{ ────────────────────────────────────────────────────────────────────── }
{ ──────────────────────────── Handler Wizard ────────────────────────── }
{ ────────────────────────────────────────────────────────────────────── }
// Handles the logic for the Next button click event in the installer wizard.
// Validates user input and required fields for each wizard page.
// Displays error messages and prevents continuation on invalid input.
// Manages plugin download and registry updates as needed.
function NextButtonClick(CurPageID: Integer): Boolean;
var
  Error: String;
begin
  // The wpReady represents the "Ready to Install" page
  // in the Inno Setup wizard, where the user confirms the installation.
  if CurPageID = wpReady then begin
    if WizardIsComponentSelected('agent') then
      WriteAgentRegistryValues;
    if WizardIsComponentSelected('plugins') then begin
      DownloadPage.Clear;
      if (PluginVer = '') or ('{#EmbeddedPluginVer}' = PluginVer) then
      begin
        Result := True;
        Exit;
      end;
        
      DownloadPage.Add(PluginURL,'centreon_plugins.exe','');
      DownloadPage.Show;
      try
        try
          DownloadPage.Download; // This downloads the files to {tmp}
          Result := True;
        except
          if DownloadPage.AbortedByUser then
            Log('Aborted by user.')
          else begin
            Error := Format('%s: %s', [DownloadPage.Name, GetExceptionMessage]);
            SuppressibleMsgBox(AddPeriod(Error), mbCriticalError, MB_OK, IDOK);
          end;
          Result := False;
          exit;
        end;
      finally
        DownloadPage.Hide;
      end;
      end;
      Result := True;
  end else if CurPageID = wpSelectComponents then begin
    if not WizardIsComponentSelected('agent') and not WizardIsComponentSelected('plugins') then begin
      MsgBox('Please select at least one component before continuing.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    // apply the change to ui
    OnLogTypeChange(LogTypeComboBox);
    Result := True;
  end else if CurPageID = ConfigPage.ID then begin
    // disable all warnings
    HostWarningBitmapImage.Hide;
    PollerWarningBitmapImage.Hide;
    LogFileWarningBitmapImage.Hide;
    InstanceWarningBitmapImage.Hide;
    
    if HostNameEdit.Text = '' then begin
      HostWarningBitmapImage.Hint := 'Please select at least one component before continuing.';
      HostWarningBitmapImage.Show;
      MsgBox('Please enter the host name. This field cannot be left empty.', mbError, MB_OK);
      Result := False;
      exit;
    end;

    if not IsValidHostPortFormat(PollerEndpointEdit.Text) then begin
      Result := False;
      exit;
    end;

    if (LogTypeComboBox.Text = 'File') and (LogFileEdit.Text = '') then begin
      LogFileWarningBitmapImage.Hint := 'Please select a log file before continuing.';
      LogFileWarningBitmapImage.Show;
      MsgBox('Please enter the log file path. This field cannot be left empty.', mbError, MB_OK);
      Result := False;
      exit;
    end;

    if (LogTypeComboBox.Text = 'File') and not(IsPathValid(LogFileEdit.Text)) then 
      begin
        LogFileWarningBitmapImage.Hint := 'Invalid log file path. Please enter a valid absolute path (e.g. C:\logs\agent.log).';
        LogFileWarningBitmapImage.Show;
        MsgBox('Invalid log file path. Please enter a valid absolute path (e.g. C:\logs\agent.log).', mbError, MB_OK);
        Result := False;
        exit;
      end;

    if PollerInitiatedCheckBox.Checked then
    begin
      if EncryptionComboBox.Items.IndexOf('Insecure TLS') <> -1 then
        EncryptionComboBox.Items.Delete(EncryptionComboBox.Items.IndexOf('Insecure TLS'));
    end
    else
    begin
      if EncryptionComboBox.Items.IndexOf('Insecure TLS') = -1 then
        EncryptionComboBox.Items.Insert(1, 'Insecure TLS');
    end;

    if (InstanceArgsEdit.Text = '') then begin
      MsgBox('Please enter the Agent instance name. This field cannot be left empty.', mbError, MB_OK);
      InstanceWarningBitmapImage.Hint := 'Please enter the Agent instance name. This field cannot be left empty.';
      InstanceWarningBitmapImage.Show;
      Result := False;
      exit;
    end
    else if ServiceAlreadyExist(InstanceArgsEdit.Text) then begin
      MsgBox('Invalid Agent instance. Already used', mbError, MB_OK);
      InstanceWarningBitmapImage.Hint := 'Invalid Agent instance. Already used';
      InstanceWarningBitmapImage.Show;
      Result := False;
      exit;
    end;

    // apply the change to ui
    OnEncryptionChange(EncryptionComboBox);

    Result := True;
  end 
  else if CurPageID = EncryptionPage.ID then begin
    PublicCertWarningBitmapImage.Hide;
    PrivateKeyWarningBitmapImage.Hide;
    CaWarningBitmapImage.Hide;
    TokenWarningBitmapImage.Hide;
    if EncryptionComboBox.Text <> 'No TLS' then begin
      if PollerInitiatedCheckBox.Checked then begin
        if not(IsPathValid(PublicCertEdit.Text)) then begin
          PublicCertWarningBitmapImage.Hint := 'Invalid public certificate file path. Please enter a valid absolute path (e.g. C:\certs\public.crt).';
          PublicCertWarningBitmapImage.Show;
          MsgBox('Invalid public certificate file path. Please enter a valid absolute path (e.g. C:\certs\public.crt).Allowed char 0..9 , A..Z , \ , . , - , ( , ) ', mbError, MB_OK);
          Result := False;
          exit;
        end;

        if not(IsPathValid(PrivateKeyEdit.Text)) then begin
          PrivateKeyWarningBitmapImage.Hint := 'Invalid private key file path. Please enter a valid absolute path (e.g. C:\certs\private.key).';
          PrivateKeyWarningBitmapImage.Show;
          MsgBox('Invalid private key file path. Please enter a valid absolute path (e.g. C:\certs\private.key).Allowed char 0..9 , A..Z , \ , . , - , ( , ) ', mbError, MB_OK);
          Result := False;
          exit;
        end;
      end
      else begin
        if not(IsPathValid(CaEdit.Text)) and (CaEdit.Text <> '') then begin
          CaWarningBitmapImage.Hint := 'Invalid CA certificate file path. Please enter a valid absolute path (e.g. C:\certs\ca.crt).';
          CaWarningBitmapImage.Show;
          MsgBox('Invalid CA certificate file path. Please enter a valid absolute path (e.g. C:\certs\ca.crt).Allowed char 0..9 , A..Z , \ , . , - , ( , ) ', mbError, MB_OK);
          Result := False;
          exit;
        end;
      end;
    end;
     if TokenEdit.Text = '' then begin
        TokenWarningBitmapImage.Hint := 'Please enter Token (JWT). This field cannot be left empty.';
        TokenWarningBitmapImage.Show;
        MsgBox('Please enter Token (JWT). This field cannot be left empty.', mbError, MB_OK);
        Result := False;
        exit;
      end;
    Result := True;
  end
  else
    Result := True;
end;

// Handles actions after installation step completes.
// Sets registry values to enable the Modify button and specify the modify executable.
// Keeps the Repair option hidden in the Windows Uninstall dialog.
// Targets the application's uninstall registry key.
procedure CurStepChanged(CurStep: TSetupStep);
var
  Key: string;
begin
  if CurStep = ssPostInstall then
  begin
    Key := 'Software\Microsoft\Windows\CurrentVersion\Uninstall\{' + '{#AppId}' + '}_is1';

    // point Modify to your modify exe in {app}
    RegWriteStringValue(HKEY_LOCAL_MACHINE, Key, 'ModifyPath',
      '"' + ExpandConstant('{app}\centreon-monitoring-agent-modify.exe') + '"');

    // enable Modify button
    RegWriteDWordValue(HKEY_LOCAL_MACHINE, Key, 'NoModify', 0);

    // (optional) keep Repair hidden
    RegWriteDWordValue(HKEY_LOCAL_MACHINE, Key, 'NoRepair', 1);
  end;
end;

{ ───────────────────────────────────────────────────────────────────────────────── }
{ ──────────────────────────── Customize uninstaller ────────────────────────────── }
{ ───────────────────────────────────────────────────────────────────────────────── }


// Manual partial removal (no uninstall of core binaries/uninstaller)
procedure PerformPartialRemoval;
var
  i, rc: Integer;
  Svc, Key: String;
begin
  // stop/delete selected services
  for i := 0 to GetArrayLength(SelectedAgents) - 1 do begin
    Svc := SelectedAgents[i];
    Exec(ExpandConstant('{sys}\sc.exe'), ' stop "' + Svc + '"', '', SW_HIDE, ewWaitUntilTerminated, rc);
    Exec(ExpandConstant('{sys}\sc.exe'), ' delete "' + Svc + '"', '', SW_HIDE, ewWaitUntilTerminated, rc);
  end;
  // delete their registry configuration
  for i := 0 to GetArrayLength(SelectedAgents) - 1 do begin
    Key := 'SOFTWARE\Centreon\' + SelectedAgents[i];
    if RegKeyExists(HKEY_LOCAL_MACHINE, Key) then
      RegDeleteKeyIncludingSubkeys(HKEY_LOCAL_MACHINE, Key);
  end;
  // optionally remove plugins (does not affect uninstaller)
  if UninstallPluginsSelected and DirExists(ExpandConstant('{app}\Plugins')) then
    DelTree(ExpandConstant('{app}\Plugins'), True, True, True);
end;

// --- Parse a comma/semicolon separated list into SelectedAgents (only keep existing ones) ---
procedure ParseParam(const S: string);
var
  Names: TArrayOfString;
  i: Integer;
begin
  Names := StringSplit(S, [',', ';'],stExcludeEmpty);
  SetArrayLength(SelectedAgents, 0);
  for i := 0 to GetArrayLength(Names) - 1 do
    if ServiceAlreadyExist(Trim(Names[i])) then
    begin
      SetArrayLength(SelectedAgents, GetArrayLength(SelectedAgents) + 1);
      SelectedAgents[GetArrayLength(SelectedAgents) - 1] := Trim(Names[i]);
    end;

end;

// --- Build uninstall selection dialog (checklist) ---
function InitializeUninstall(): Boolean;
var
  Frm: TSetupForm;
  Lbl: TLabel;
  BtnOK, BtnCancel: TNewButton;
  i: Integer;
  TotalAgents, SelectedCount: Integer;
  Agentinstance: String;
begin
  Result := True;
  LoadAgentRegistryKeys;

  HavePluginsInInstall := DirExists(ExpandConstant('{app}\Plugins'));

  // --- Silent targeted uninstall shortcut ---
  if IsSilentMode then
  begin
    Agentinstance := ExpandConstant('{param:agentinstance|}');
    UninstallPluginsSelected := CmdLineParamExists('/plugins');
    FullUninstall := CmdLineParamExists('/full');

    // Full uninstall shortcut: remove all agents + plugins if present
    if FullUninstall then
      begin 
        // Full uninstall: select all agents + plugins if present
        SetArrayLength(SelectedAgents, GetArrayLength(AgentNames));
        for i := 0 to GetArrayLength(AgentNames) - 1 do
          SelectedAgents[i] := AgentNames[i];
        UninstallPluginsSelected := True;
        Result := True;
        Exit;
    end;

    // Targeted uninstall shortcut: parse agentinstance param (if any) + plugins if /plugins
    if Agentinstance <> '' then
      ParseParam(Agentinstance)
    else if GetArrayLength(AgentNames) > 0 then
    begin
      SetArrayLength(SelectedAgents, 1);
      SelectedAgents[0] := AgentNames[0];
    end;
    
    if (GetArrayLength(SelectedAgents) = 0) and (not HavePluginsInInstall) then begin
      LogToStdOutFile('Nothing to uninstall: no Centreon agents or plugins. Check your parameters.');
      Result := False;
      Exit;
    end;
    
  end
  else
  begin

    // --- Normal (interactive) flow continues below ---
    if (GetArrayLength(AgentNames) = 0) and (not HavePluginsInInstall) then begin
      MsgBox('Nothing to uninstall: no Centreon agents or plugins detected.', mbInformation, MB_OK);
      Result := False;
      Exit;
    end;

    Frm := CreateCustomForm(ScaleX(480), ScaleY(340), False, False);
    Frm.Caption := 'Centreon Uninstall';

    Lbl := TLabel.Create(Frm);
    Lbl.Parent := Frm;
    Lbl.Caption := 'Select the Centreon components / agent instances to remove:';
    Lbl.Left := ScaleX(12);
    Lbl.Top := ScaleY(12);
    Lbl.AutoSize := True;

    AgentsCheckList := TNewCheckListBox.Create(Frm);
    AgentsCheckList.Parent := Frm;
    AgentsCheckList.Left := Lbl.Left;
    AgentsCheckList.Top := Lbl.Top + ScaleY(22);
    AgentsCheckList.Width := Frm.ClientWidth - ScaleX(24);
    AgentsCheckList.Height := Frm.ClientHeight - ScaleY(100);
    AgentsCheckList.BorderStyle := bsSingle;

    if HavePluginsInInstall then
      AgentsCheckList.AddCheckBox('Plugins','',0, False, True, False,False, nil);

    for i := 0 to GetArrayLength(AgentNames) - 1 do
      AgentsCheckList.AddCheckBox(AgentNames[i],'',0, False, True, False,False, nil);

    BtnOK := TNewButton.Create(Frm);
    BtnOK.Parent := Frm;
    BtnOK.Caption := SetupMessage(msgButtonOK);
    BtnOK.ModalResult := mrOk;
    BtnOK.Top := Frm.ClientHeight - BtnOK.Height - ScaleY(16);
    BtnOK.Left := Frm.ClientWidth - BtnOK.Width * 2 - ScaleX(32);

    BtnCancel := TNewButton.Create(Frm);
    BtnCancel.Parent := Frm;
    BtnCancel.Caption := SetupMessage(msgButtonCancel);
    BtnCancel.ModalResult := mrCancel;
    BtnCancel.Top := BtnOK.Top;
    BtnCancel.Left := BtnOK.Left + BtnOK.Width + ScaleX(10);

    while True do
    begin
      case Frm.ShowModal of
        mrOk:
          begin
            SetArrayLength(SelectedAgents, 0);
            UninstallPluginsSelected := False;
            for i := 0 to AgentsCheckList.Items.Count - 1 do
              if AgentsCheckList.State[i] = cbChecked then
              begin
                if AgentsCheckList.ItemCaption[i] = 'Plugins' then
                  UninstallPluginsSelected := True
                else
                begin
                  SetArrayLength(SelectedAgents, GetArrayLength(SelectedAgents) + 1);
                  SelectedAgents[GetArrayLength(SelectedAgents) - 1] := AgentsCheckList.ItemCaption[i];
                end;
              end;

            if (GetArrayLength(SelectedAgents) = 0) and (not UninstallPluginsSelected) then
            begin
              MsgBox('Select at least one item to uninstall.', mbError, MB_OK);
              Continue;
            end;
            Break;
          end;
        mrCancel:
          begin
            Result := False;  // abort uninstall
            Break;
          end;
      end;
    end;

    Frm.Free;
  end;

if not Result then Exit;

TotalAgents := GetArrayLength(AgentNames);
SelectedCount := GetArrayLength(SelectedAgents);

  // Full uninstall only if all agents selected AND (no plugins present OR plugins selected)
FullUninstall :=(SelectedCount = TotalAgents) and
  ( (not HavePluginsInInstall) or (UninstallPluginsSelected) );

if not FullUninstall then begin
    // Perform partial manual removal & keep uninstaller
    PerformPartialRemoval;
    if not(IsSilentMode) then
      MsgBox('Selected items removed. Remaining agents kept; uninstaller retained for future removal.', mbInformation, MB_OK);
    ExitProcess(0);// the uninstall is done,we not to abort uninstaller to be deleted
  end;
end;

// --- Perform selective removal after files removed by default uninstaller ---
procedure CurUninstallStepChanged(CurStep: TUninstallStep);
var
  i, rc: Integer;
  Svc: String;
  Key: String;
begin
  if CurStep = usUninstall then
  begin
    // Stop & delete selected services first
    for i := 0 to GetArrayLength(SelectedAgents) - 1 do
    begin
      Svc := SelectedAgents[i];
      Exec(ExpandConstant('{sys}\sc.exe'), ' stop "' + Svc + '"', '', SW_HIDE, ewWaitUntilTerminated, rc);
      Exec(ExpandConstant('{sys}\sc.exe'), ' delete "' + Svc + '"', '', SW_HIDE, ewWaitUntilTerminated, rc);
    end;
  // add a sleep here to ensure services are fully stopped before deleting registry keys & files
  Sleep(2000);
  end
  else if CurStep = usPostUninstall then
  begin
    // Remove registry keys for selected agents
    for i := 0 to GetArrayLength(SelectedAgents) - 1 do
    begin
      Key := 'SOFTWARE\Centreon\' + SelectedAgents[i];
      if RegKeyExists(HKEY_LOCAL_MACHINE, Key) then
        RegDeleteKeyIncludingSubkeys(HKEY_LOCAL_MACHINE, Key);
    end;

    // Delete plugins if chosen
    if UninstallPluginsSelected and DirExists(ExpandConstant('{app}\Plugins')) then
      DelTree(ExpandConstant('{app}\Plugins'), True, True, True);

    if DirExists(ExpandConstant('{app}\CentreonMonitoringAgent')) then
      DelTree(ExpandConstant('{app}\CentreonMonitoringAgent'), True, True, True);
  end;
end;
