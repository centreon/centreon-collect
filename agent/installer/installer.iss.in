#define AppName "Centreon Monitoring Agent"
#define AppVersion "@AGENT_VERSION@"
#define AppExePath "@CENTAGENT_PATH@"
#define AppPublisher "Centreon"
#define AppURL "https://www.centreon.com/"
#define AppExeName "centagent.exe"
#define PluginExePath "@PLUGIN_DOWNLOAD_PATH@"
#define BaseUrl "https://api.github.com/repos/centreon/centreon-nsclient-build/releases/latest"
#define PluginSize "@PLUGIN_SIZE@"
#define EmbeddedPluginVer "@PLUGIN_VERSION@"
#define ModifierPathexe "@OUTPUT_DIR@/@OUTPUT_BASE_FILENAME_MODIFIER@.exe"


#define LicenseFile "resources\license.txt"
#define CentreonIcon "resources\centreon_icon.ico"
#define CentreonLogo "resources\centreon_logo.bmp"
#define CentreonLogoLarge "resources\centreon_logo_large.bmp"
#define WarningIcon "resources\warning_icon.bmp"
#define InfoIcon "resources\info_icon.bmp"

#define OutputDir "@OUTPUT_DIR@"
#define OutputBaseFilename "@OUTPUT_BASE_FILENAME_INSTALLER@"

#define AppId "D80E49AC-E863-41E6-A157-54AB2960FFC8"

[Setup]
AppId={{{#AppId}}
AppName={#AppName}
AppVersion={#AppVersion}
AppPublisher={#AppPublisher}
AppPublisherURL={#AppURL}
AppSupportURL={#AppURL}
AppUpdatesURL={#AppURL}
DefaultDirName={autopf}\Centreon
UninstallDisplayIcon={app}\{#AppExeName}
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
DefaultGroupName={#AppName}
DisableProgramGroupPage=yes
OutputBaseFilename={#OutputBaseFilename}
OutputDir={#OutputDir}
SolidCompression=no
WizardStyle=modern
WizardResizable=no
DisableWelcomePage=no
DisableDirPage=yes
LicenseFile={#LicenseFile}
SetupIconFile ={#CentreonIcon}
PrivilegesRequired=admin
PrivilegesRequiredOverridesAllowed=commandline
UsePreviousAppDir=no
AlwaysUsePersonalGroup=false
SetupLogging=yes
Uninstallable=yes
DisableStartupPrompt=yes
WizardImageFile={#CentreonLogoLarge}
WizardSmallImageFile={#CentreonLogo}
WizardImageStretch=yes
@INNO_SIGNING_SETUP@


[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Types]
Name: "custom"; Description: "Custom installation"; Flags: iscustom


[Components]
Name: "agent";   Description: "Centreon Monitoring Agent"; Types: custom 
Name: "plugins"; Description: "Plugins";  Types: custom 

[Files]
Source: "{#AppExePath}"; DestDir: "{app}\CentreonMonitoringAgent"; Components: agent
Source: "{#ModifierPathexe}"; DestDir: "{app}"; Flags: ignoreversion; Components: agent
Source: "{#PluginExePath}"; DestDir: "{app}\Plugins";Components: plugins; Flags: ignoreversion; Check: ShouldInstallEmbeddedPlugin
Source: "{tmp}\centreon_plugins.exe"; DestDir: "{app}\Plugins";ExternalSize:{#PluginSize}; Flags: external ignoreversion ;Components: plugins;Check: not(ShouldInstallEmbeddedPlugin)
Source: {#InfoIcon}; Flags: dontcopy
Source: {#WarningIcon}; Flags: dontcopy

[Run]
Filename: "sc.exe"; Parameters: "{code:GetScCreateParams}"; Flags: runhidden; Components: agent
Filename: "sc.exe"; Parameters: "{code:GetScDescriptionParams}"; Flags: runhidden; Components: agent
Filename: "sc.exe"; Parameters: "start {code:GetInstanceArgs}"; Flags: runhidden; Components: agent


