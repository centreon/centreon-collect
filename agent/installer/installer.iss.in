  InstanceInfoBitmapImage.Height := 24;
  InstanceInfoBitmapImage.Stretch := True;
  InstanceInfoBitmapImage.Cursor := crHand;
  InstanceInfoBitmapImage.OnClick := @BitmapImageOnClick;

  InstanceWarningBitmapImage := TBitmapImage.Create(ConfigPage);
