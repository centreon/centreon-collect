// Returns instance entered by user or a defaut value.
function GetInstanceArgs(Param: string): string;
begin
  if (InstanceArgsEdit = nil) or (Trim(InstanceArgsEdit.Text) = '') then
    Result := 'CentreonMonitoringAgent'
  else
    Result := Trim(InstanceArgsEdit.Text);
end;


// --- Enumerate Centreon agent registry subkeys ---
procedure LoadAgentRegistryKeys;
begin
  SetArrayLength(AgentNames, 0);
  RegGetSubkeyNames(HKEY_LOCAL_MACHINE, 'SOFTWARE\Centreon', AgentNames);
end;

function ServiceAlreadyExist(SvcName: string):Boolean;
var 
  Agent: Integer;
begin
  LoadAgentRegistryKeys;
  Result := False;
  if GetArrayLength(AgentNames) = 0 then
    Exit;

  for Agent := 0 to GetArrayLength(AgentNames) - 1 do
  begin
    if CompareText(AgentNames[Agent], SvcName) = 0 then
    begin
      Result := True;
      Exit;
    end;
  end;
end;

function ProposeServiceName(BaseName: string): string;
var
  Candidate: string;
  Index: Integer;
begin
  // Start with the plain base name
  Candidate := BaseName;

  Index := 0;
  while ServiceAlreadyExist(Candidate) do
  begin
    Index := Index + 1;
    Candidate := BaseName + IntToStr(Index);
  end;

  Result := Candidate;
end;

// Build full 'sc create' parameter string with correct quoting.
// Result example:
// create CentreonMonitoringAgent binPath= "\"C:\Program Files\Centreon\CentreonMonitoringAgent\centagent.exe\" --service-name CentreonMonitoringAgent" start= auto DisplayName= "CentreonMonitoringAgent"
function GetScCreateParams(Param: string): string;
var
  svc: string;
begin
  svc := GetInstanceArgs('');
  Result :=
    'create ' + svc +
    ' binPath= "\"' + ExpandConstant('{app}\CentreonMonitoringAgent\{#AppExeName}') +
    '\" --service-name ' + svc + '" start= auto DisplayName= "' + svc + '"';
end;

// build the 'sc description' parameters
function GetScDescriptionParams(Param: string): string;
begin
  Result :=
    'description ' + GetInstanceArgs('') +
    ' "Centreon agent used for monitoring and metric collection"';
end;


// Logs a message with a timestamp to 'installer_output.log' in the source executable's directory.
procedure LogToStdOutFile(Msg: String);
var
  LogFile: String;
  LogLine: String;
begin
  LogFile := AddBackslash(ExtractFileDir(ExpandConstant('{srcexe}'))) +
             'installer_output.log';
  LogLine := GetDateTimeString('yyyy-mm-dd hh:nn:ss', #0, #0) + ' - ' + Msg + #13#10;
  // Append log line to file, fail silently if error
  SaveStringToFile(LogFile, LogLine, True);
end;

// Checks if a specific command line parameter exists.
// Param: The parameter string to search for.
// Returns: True if the parameter is found among the command line arguments; otherwise, False.
function CmdLineParamExists(Param: string): Boolean;
var
  I: Integer;
begin
  for I := 1 to ParamCount do
    if CompareText(ParamStr(I), Param) = 0 then
    begin
      Result := True;
      Exit;
    end;
  Result := False;
end;

// Checks if the given path string is a valid Windows absolute path.
// Returns True if the path matches the expected format and contains only allowed characters.
function IsPathValid(Path: string): Boolean;
var
  I: Integer;
begin
  Path := Uppercase(Path);
  Result :=
    (Length(Path) >= 3) and
    (Path[1] >= 'A') and (Path[1] <= 'Z') and
    (Path[2] = ':') and
    (Path[3] = '\');

  if Result then
  begin
    for I := 3 to Length(Path) do
    begin
      case Path[I] of
        '0'..'9', 'A'..'Z', '\', ' ', '.', '-', '_', '(', ')':
          else 
        begin
          Result := False;
          Break;
        end;
      end;
    end;
  end;
end;

// Checks if the input string is in "host:port" format and validates host and port characters.
// Displays error messages and hints if the format or values are invalid.
function IsValidHostPortFormat(S: String): Boolean;
var
  Host, Port: String;
  ColonPos, i: Integer;
  c: Char;
begin
  Result := False;
  ColonPos := Pos(':', S);

  if (ColonPos > 1) and (ColonPos < Length(S)) then
  begin
    Host := Copy(S, 1, ColonPos - 1);
    Port := Copy(S, ColonPos + 1, Length(S));

    // Validate host characters
    for i := 1 to Length(Host) do
    begin
      c := Host[i];
      if not ((c >= 'a') and (c <= 'z') or
            (c >= 'A') and (c <= 'Z') or
            (c >= '0') and (c <= '9') or
            (c = '.') or (c = '-') or (c = '_')) then begin
      PollerWarningBitmapImage.Hint := 'Host contains invalid characters.';
      PollerWarningBitmapImage.Show;
      MsgBox('Host contains invalid characters.', mbError, MB_OK);
      Exit;
      end;
    end;

    // Validate port (must be all digits)
    if Length(Port) = 0 then begin
      PollerWarningBitmapImage.Hint := 'Missing port number after ":". Please provide a valid port.';
      PollerWarningBitmapImage.Show;
      MsgBox('Missing port number after ":". Please provide a valid port.', mbError, MB_OK);
      Exit;
    end;
    for i := 1 to Length(Port) do
    begin
      if Pos(Port[i], '0123456789') = 0 then begin
        PollerWarningBitmapImage.Hint := 'Invalid port: it must contain only digits (0-9).';
        PollerWarningBitmapImage.Show;
        MsgBox('Invalid port: it must contain only digits (0-9).', mbError, MB_OK);
        Exit;
      end;
    end;

    Result := True;
  end else begin
    PollerWarningBitmapImage.Hint := 'Invalid format. Please enter in the format "host:port", e.g. "localhost:8080".';
    PollerWarningBitmapImage.Show;
    MsgBox('Invalid format. Please enter in the format "host:port", e.g. "localhost:8080".', mbError, MB_OK);
    Exit;
  end;
end;

// Retrieves the current Windows computer name as a string.
// Returns an empty string if the computer name cannot be obtained.
function GetWindowsHostName: String;
var
  buf: String;
  size: LongWord;
begin
  size := 255;
  SetLength(buf, size);
  if GetComputerName(buf, size) then
    Result := Copy(buf, 1, size)
  else
    Result := '';
end;

// Reads Centreon Monitoring Agent configuration values from the Windows registry and populates the installer UI fields accordingly.
// For each expected registry value under 'SOFTWARE\Centreon\CentreonMonitoringAgent', attempts to read the value:
//   - If found, sets the corresponding UI control (edit box, combo box, or checkbox) with the value.
//   - If not found for 'host', uses the current Windows host name as a fallback.
// Handles both string and DWORD registry values, converting as needed for UI controls.
procedure ReadAgentRegistryValues;
var
  RootKey: Integer;
  BaseKey: String;
  StrValue: String;
  DwordValue: DWORD;
begin
  RootKey := HKEY_LOCAL_MACHINE;
  BaseKey := 'SOFTWARE\Centreon\CentreonMonitoringAgent';

  if RegQueryStringValue(RootKey, BaseKey, 'host', StrValue) then
    HostNameEdit.Text := StrValue
  else
    HostNameEdit.Text := GetWindowsHostName;

  if RegQueryStringValue(RootKey, BaseKey, 'endpoint', StrValue) then
    PollerEndpointEdit.Text := StrValue;

  if RegQueryStringValue(RootKey, BaseKey, 'log_file', StrValue) then
    LogFileEdit.Text := StrValue;

  if RegQueryStringValue(RootKey, BaseKey, 'log_level', StrValue) then
    LogLeveLComboBox.ItemIndex := LogLeveLComboBox.Items.IndexOf(StrValue);

  if RegQueryStringValue(RootKey, BaseKey, 'custom_check_file', StrValue) then
    CustomCheckEdit.Text := StrValue;

  if RegQueryStringValue(RootKey, BaseKey, 'log_type', StrValue) then
    LogTypeComboBox.ItemIndex := LogTypeComboBox.Items.IndexOf(StrValue);

  if RegQueryStringValue(RootKey, BaseKey, 'public_cert', StrValue) then
    PublicCertEdit.Text := StrValue;

  if RegQueryStringValue(RootKey, BaseKey, 'private_key', StrValue) then
    PrivateKeyEdit.Text := StrValue;

  if RegQueryStringValue(RootKey, BaseKey, 'ca_certificate', StrValue) then
    CaEdit.Text := StrValue;

  if RegQueryStringValue(RootKey, BaseKey, 'ca_name', StrValue) then
    CommonNameEdit.Text := StrValue;

  if RegQueryStringValue(RootKey, BaseKey, 'token', StrValue) then
    TokenEdit.Text := StrValue;

  if RegQueryStringValue(RootKey, BaseKey, 'encryption', StrValue) then
  begin
    if StrValue = 'full' then
      EncryptionComboBox.ItemIndex := EncryptionComboBox.Items.IndexOf('TLS')
    else if StrValue = 'insecure' then
      EncryptionComboBox.ItemIndex := EncryptionComboBox.Items.IndexOf('Insecure TLS')
    else
      EncryptionComboBox.ItemIndex := EncryptionComboBox.Items.IndexOf('No TLS');
  end;

  if RegQueryDWordValue(RootKey, BaseKey, 'log_max_file_size', DwordValue) then
    MaxFileEdit.Text := IntToStr(DwordValue);

  if RegQueryDWordValue(RootKey, BaseKey, 'log_max_files', DwordValue) then
    MaxNumberEdit.Text := IntToStr(DwordValue);

  if RegQueryDWordValue(RootKey, BaseKey, 'reversed_grpc_streaming', DwordValue) then
    PollerInitiatedCheckBox.Checked := (DwordValue <> 0);
end;

// Writes Centreon Monitoring Agent configuration values to the Windows registry.
// This procedure sets string and DWORD values under the key 'SOFTWARE\Centreon\GetInstanceArgs()' in HKEY_LOCAL_MACHINE.
// The values are retrieved from various UI controls, including host, endpoint, log settings, certificates, and agent options.
procedure WriteAgentRegistryValues;
var
  RootKey: Integer;
  BaseKey: String;
begin
  RootKey := HKEY_LOCAL_MACHINE;
  // Use the selected service name so the agent (which builds the path with the service name) reads the same location.
  BaseKey := 'SOFTWARE\Centreon\' + GetInstanceArgs('');

  // Strings
  RegWriteStringValue(RootKey, BaseKey, 'host', HostNameEdit.Text);
  RegWriteStringValue(RootKey, BaseKey, 'endpoint', PollerEndpointEdit.Text);
  RegWriteStringValue(RootKey, BaseKey, 'log_file', LogFileEdit.Text);
  RegWriteStringValue(RootKey, BaseKey, 'custom_check_file', CustomCheckEdit.Text);
  RegWriteStringValue(RootKey, BaseKey, 'log_level', LowerCase(LogLeveLComboBox.Text));
  RegWriteStringValue(RootKey, BaseKey, 'log_type', LowerCase(LogTypeComboBox.Text));
  RegWriteStringValue(RootKey, BaseKey, 'public_cert', PublicCertEdit.Text);
  RegWriteStringValue(RootKey, BaseKey, 'private_key', PrivateKeyEdit.Text);
  RegWriteStringValue(RootKey, BaseKey, 'ca_certificate', CaEdit.Text);
  RegWriteStringValue(RootKey, BaseKey, 'ca_name', CommonNameEdit.Text);
  RegWriteStringValue(RootKey, BaseKey, 'token', TokenEdit.Text);

  if EncryptionComboBox.Text = 'TLS' then
    RegWriteStringValue(RootKey, BaseKey, 'encryption', 'full')
  else if EncryptionComboBox.Text = 'Insecure TLS' then
    RegWriteStringValue(RootKey, BaseKey, 'encryption', 'insecure')
  else
    RegWriteStringValue(RootKey, BaseKey, 'encryption', 'no');

  // DWORDs
  RegWriteDWordValue(RootKey, BaseKey, 'log_max_file_size', StrToIntDef(MaxFileEdit.Text, 10));
  RegWriteDWordValue(RootKey, BaseKey, 'log_max_files', StrToIntDef(MaxNumberEdit.Text, 10));
  RegWriteDWordValue(RootKey, BaseKey, 'reversed_grpc_streaming', Integer(PollerInitiatedCheckBox.Checked));
end;


// Returns the position of the first occurrence of the substring SubStr within the string S,
// starting the search at the specified Offset (1-based index). If SubStr is not found, returns 0.
// Parameters:
//   SubStr - The substring to search for.
//   S      - The string to search within.
//   Offset - The position in S to start searching from (1-based).
// Returns:
//   Integer - The position of SubStr in S, or 0 if not found.
function PosEx(const SubStr, S: string; Offset: Integer): Integer;
var
  i: Integer; L: Integer;
begin
  Result := 0;
  if Offset < 1 then Offset := 1;
  L := Length(SubStr);
  for i := Offset to Length(S) - L + 1 do
    if Copy(S, i, L) = SubStr then
    begin
      Result := i;
      Exit;
    end;
end;

// Performs an HTTP GET request to the specified URL using WinHttp.
// Returns the response body and HTTP status code via output parameters.
// Returns True if the request succeeds with a 2xx status code, otherwise False.

function HttpGet(const Url: string; out Body: string; out Status: Integer): Boolean;
var
  Http: Variant;
  Flags: DWORD;
begin
  Result := False;
  Body := '';
  Status := 0;
  
   Flags := 0;
  if not InternetCheckConnectionW('https://api.github.com/',  1, 0) then
    Exit;

  try
    Http := CreateOleObject('WinHttp.WinHttpRequest.5.1');
    Http.Open('GET', Url, False);
    // GitHub requires a User-Agent
    Http.SetRequestHeader('User-Agent', 'InnoSetup/6.4.3');
    Http.SetRequestHeader('Accept', 'application/vnd.github+json');
    // timeouts: resolve, connect, send, receive (ms)
    Http.SetTimeouts(8000, 8000, 15000, 150000);
    Http.Send('');
    Status := Http.Status;
    if (Status >= 200) and (Status < 300) then
    begin
      Body := Http.ResponseText;
      Result := True;
    end;
  except
    // swallow, Result stays False
  end;
 end;

// Retrieves the browser download URL for a specific asset from a JSON API response.
// Makes an HTTP GET request to the given ApiUrl and searches for AssetName.
// Returns the download URL if found, otherwise returns an empty string.
// Logs an error if the HTTP request fails.
function GetBrowserDownloadURL(const ApiUrl, AssetName: string): string;
var
  Json: string;
  Status: Integer;
  p, p2: Integer;
begin
  Result := '';
  if not HttpGet(ApiUrl, Json, Status) then
  begin
    Log(Format('HTTP failed (status=%d) for %s', [Status, ApiUrl]));
    Exit;
  end;

  // First try: find the specific asset by name, then its URL after
  p := Pos('"name":"' + AssetName + '"', Json);
  if p > 0 then
  begin
    p := PosEx('"browser_download_url":"', Json, p);
    if p > 0 then
    begin
      p := p + Length('"browser_download_url":"');
      p2 := PosEx('"', Json, p);
      if p2 > p then
      begin
        Result := Copy(Json, p, p2 - p);
        Exit;
      end;
    end;
  end;
end;

// Extracts the version string from a given URL.
// Searches for the substring between 'download/' and '/centreon_plugins.exe'.
// Returns the extracted version or an empty string if not found.
// Assumes the URL follows a specific format for Centreon plugin downloads.
function ExtractVersionFromURL(const Url: string): string;
var
  p1, p2: Integer;
begin
  Result := '';
  p1 := Pos('download/', Url);
  if p1 > 0 then
  begin
    p1 := p1 + Length('download/');
    p2 := Pos('/centreon_plugins.exe', Copy(Url, p1, MaxInt));
    if p2 > 0 then
      Result := Copy(Url, p1, p2 - 1);
  end;
end;

// Determines whether the embedded plugin should be installed.
// Returns True if the plugin source is 'embedded', or if no URL is provided,
// or if the plugin version matches the embedded version.
// Used to control plugin installation logic during setup.
function ShouldInstallEmbeddedPlugin: Boolean;
begin
  // Only install embedded version if no URL or same version
  if PluginSrc = 'embedded' then
    Result := True
  else
  Result := (pluginUrl = '') or (pluginVer = '{#EmbeddedPluginVer}');
end;

{ ────────────────────────────────────────────────────────────────────── }
{ ───────────────────────── Silent Mode ──────────────────────────────── }
{ ────────────────────────────────────────────────────────────────────── }
function IsSilentMode: Boolean;
begin
  Result := CmdLineParamExists('/silent') or CmdLineParamExists('/verysilent');
end;

// Loads installer parameters in silent mode from command-line arguments.
// Populates UI fields with provided or default values.
// Handles log type, log level, encryption, and certificate settings.
// Only executes if installer is running in silent mode.
procedure LoadSilentParameters;
begin
  if not IsSilentMode then Exit;
  InstanceArgsEdit.Text := ExpandConstant('{param:agentinstance|}');
  if InstanceArgsEdit.Text = '' then
    InstanceArgsEdit.Text := ProposeServiceName('CentreonMonitoringAgent');

  HostNameEdit.Text := ExpandConstant('{param:host|}');
  PollerEndpointEdit.Text := ExpandConstant('{param:endpoint|}');

  if LowerCase(ExpandConstant('{param:logtype|event-log}')) = 'file' then
    LogTypeComboBox.ItemIndex := 1
  else
    LogTypeComboBox.ItemIndex := 0;

  // Set log level using item index, matching lower case
  case LowerCase(ExpandConstant('{param:loglevel|error}')) of
    'off':      LogLeveLComboBox.ItemIndex := LogLeveLComboBox.Items.IndexOf('Off');
    'critical': LogLeveLComboBox.ItemIndex := LogLeveLComboBox.Items.IndexOf('Critical');
    'error':    LogLeveLComboBox.ItemIndex := LogLeveLComboBox.Items.IndexOf('Error');
    'warning':  LogLeveLComboBox.ItemIndex := LogLeveLComboBox.Items.IndexOf('Warning');
    'info':     LogLeveLComboBox.ItemIndex := LogLeveLComboBox.Items.IndexOf('Info');
    'debug':    LogLeveLComboBox.ItemIndex := LogLeveLComboBox.Items.IndexOf('Debug');
    'trace':    LogLeveLComboBox.ItemIndex := LogLeveLComboBox.Items.IndexOf('Trace');
    else        LogLeveLComboBox.ItemIndex := LogLeveLComboBox.Items.IndexOf('Error');
  end;
  LogFileEdit.Text := ExpandConstant('{param:logfile|}');
  CustomCheckEdit.Text := ExpandConstant('{param:customcheckfile|}');
  MaxFileEdit.Text := ExpandConstant('{param:maxfilesize|}');
  MaxNumberEdit.Text := ExpandConstant('{param:maxnumber|}');
  PollerInitiatedCheckBox.Checked := (LowerCase(ExpandConstant('{param:reverse|false}')) = 'true');

  // Set encryption combo box based on parameter value
  case LowerCase(ExpandConstant('{param:encryption|no}')) of
    'full':     EncryptionComboBox.ItemIndex := EncryptionComboBox.Items.IndexOf('TLS');
    'insecure': EncryptionComboBox.ItemIndex := EncryptionComboBox.Items.IndexOf('Insecure TLS');
    else        EncryptionComboBox.ItemIndex := EncryptionComboBox.Items.IndexOf('No TLS');
  end;
  PublicCertEdit.Text := ExpandConstant('{param:cert|}');
  PrivateKeyEdit.Text := ExpandConstant('{param:key|}');
  CaEdit.Text := ExpandConstant('{param:ca|}');
  CommonNameEdit.Text := ExpandConstant('{param:commonname|}');
  TokenEdit.Text := ExpandConstant('{param:token|}');

  PluginSrc := LowerCase(ExpandConstant('{param:pluginsrc|auto}'));
end;

// Checks validity of silent installation parameters.
// Validates required fields, formats, and values for host, endpoint, logging, encryption, and plugin source.
// Logs errors to standard output and returns False if any check fails.
// Returns True if all parameters are valid.
function CheckSilentParameterValidity: Boolean;
var
  AgentInstance: string;
  HostParam, EndpointParam, LogTypeParam, LogFileParam,Loglvl: string;
  Pluginsrc_p: string;
  EncryptionEnabled,PollerInitiatedEnabled: Boolean;
begin
  if not IsSilentMode then
  begin
    Result := True;
    Exit;
  end;

  AgentInstance := ExpandConstant('{param:agentinstance|}');
  HostParam := ExpandConstant('{param:host|}');
  EndpointParam := ExpandConstant('{param:endpoint|}');
  LogTypeParam := LowerCase(ExpandConstant('{param:logtype|event-log}'));
  LogFileParam := ExpandConstant('{param:logfile|}');
  EncryptionEnabled := (LowerCase(ExpandConstant('{param:encryption|no}')) = 'full') or
                       (LowerCase(ExpandConstant('{param:encryption|no}')) = 'insecure');
  PollerInitiatedEnabled := (LowerCase(ExpandConstant('{param:reverse|false}')) = 'true');

  // Service name
  if (AgentInstance <> '') and ServiceAlreadyExist(AgentInstance) then
  begin
    LogToStdOutFile('Agent instance already exists: ' + AgentInstance);
    Result := False;
    Exit;
  end;

  // HOST
  if HostParam = '' then
  begin
    LogToStdOutFile('Missing parameter: /HOST');
    Result := False;
    Exit;
  end;

  // ENDPOINT format host:port
  if (Pos(':', EndpointParam) = 0) or (Copy(EndpointParam, Length(EndpointParam), 1) = ':') then
  begin
    LogToStdOutFile('Invalid format for /ENDPOINT. Expected "host:port".');
    Result := False;
    Exit;
  end;

  // if logtype = file → log file mandatory
  if LogTypeParam = 'file' then
  begin
    if not(IsPathValid(LogFileParam)) then
    begin
      LogToStdOutFile('Missing /LOGFILE when /LOGTYPE=file');
      Result := False;
      Exit;
    end;
  end;

  // check log level 
  Loglvl := LowerCase(ExpandConstant('{param:loglevel|error}'));
  if (Loglvl <> 'off') and (Loglvl <> 'critical') and (Loglvl <> 'error') and (Loglvl <> 'warning') and (Loglvl <> 'info') and (Loglvl <> 'debug') and (Loglvl <> 'trace') then
  begin
    LogToStdOutFile('Invalid /LOGLEVEL value. Allowed values: off|critical|error|warning|info|debug|trace');
    Result := False;
    Exit;
  end;

  // if encryption test cert key token
  if EncryptionEnabled then
  begin
    if PollerInitiatedEnabled then begin
      if not(IsPathValid(ExpandConstant('{param:cert|}'))) then
      begin
        LogToStdOutFile('Missing or invalid /CERT path. Provide a valid absolute path (e.g., C:\certs\public.crt) when /ENCRYPTION=full/insecure.');
        Result := False;
        Exit;
      end;

      if not(IsPathValid(ExpandConstant('{param:key|}'))) then
      begin
        LogToStdOutFile('Missing or invalid /KEY path. Provide a valid absolute path (e.g., C:\certs\private.key) when /ENCRYPTION=full/insecure.');
        Result := False;
        Exit;
      end;
     end
    else begin
      if (ExpandConstant('{param:ca|}') <> '') and not(IsPathValid(ExpandConstant('{param:ca|}'))) then
        begin
          LogToStdOutFile('Invalid /CA path. Provide a valid absolute path (e.g., C:\certs\ca.crt) when /ENCRYPTION=full/insecure');
          Result := False;
          Exit;
        end;
    end;
     
    if ExpandConstant('{param:token|}') = '' then
    begin
      LogToStdOutFile('Missing /TOKEN when /ENCRYPTION=full/insecure');
      Result := False;
      Exit;
    end;
  end;

  Pluginsrc_p := LowerCase(ExpandConstant('{param:pluginsrc|auto}'));
  if (Pluginsrc_p <> 'auto') and (Pluginsrc_p <> 'embedded') then begin
    LogToStdOutFile('Invalid /PLUGINSRC value. Use auto|embedded.');
    Result := False;
    Exit;
  end;

  // all good
  Result := True;
end;

{ ────────────────────────────────────────────────────────────────────── }
{ ───────────────────────── Start Wizard ─────────────────────────────── }
{ ────────────────────────────────────────────────────────────────────── }
// Initializes the setup process, handles silent mode and version display.
// Returns True if silent parameters are valid, otherwise exits with error.
function InitializeSetup(): Boolean;
begin
  PluginSrc := 'auto';
  // ── Silent mode
   if CmdLineParamExists('/VERSION') then
  begin
    LogToStdOutFile('{#AppName} {#AppVersion}'#13#10);
    LogToStdOutFile('Embedded plugin version: {#EmbeddedPluginVer}'#13#10);
    ExitProcess(0);
  end;
  Result := CheckSilentParameterValidity;

  if not Result then
  ExitProcess(1)  
end;

// Initializes the Centreon Agent installer wizard, configuring custom pages and UI elements for agent setup.
procedure InitializeWizard;
var
Infobmp: String;
WarningBmp: String;
begin

// ── Wizard config
  WizardForm.ClientWidth := 630;
  WizardForm.ClientHeight := 570;
  PluginURL := GetBrowserDownloadURL(
         'https://api.github.com/repos/centreon/centreon-nsclient-build/releases/latest',
         'centreon_plugins.exe');
  PluginVer := ExtractVersionFromURL(PluginURL);

// ── Load resources 
  ExtractTemporaryFile('info_icon.bmp');
  Infobmp := ExpandConstant('{tmp}\info_icon.bmp');
  ExtractTemporaryFile('warning_icon.bmp');
  WarningBmp := ExpandConstant('{tmp}\warning_icon.bmp');
// ── Config page 
  ConfigPage := CreateCustomPage(wpSelectComponents, 'Centreon Agent Configuration', 'Please provide the required information to connect agent.');

  // ──── Service Name

  InstanceArgsLabel := TNewStaticText.Create(ConfigPage);
  InstanceArgsLabel.Parent := ConfigPage.Surface;
  InstanceArgsLabel.Top := ScaleY(3);
