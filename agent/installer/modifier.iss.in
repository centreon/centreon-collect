  // ──── Private key

  PrivateKeyLabel := TNewStaticText.Create(EncryptionPage);
  PrivateKeyLabel.Parent := EncryptionPage.Surface;
  PrivateKeyLabel.Top := PublicCertLabel.Top + ScaleY(30);
  PrivateKeyLabel.Caption := 'Private key:';
