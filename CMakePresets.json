{
    "version": 2,
    "configurePresets": [
        {
            "name": "debug",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build_windows",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "WITH_TESTING": "On",
                "VCPKG_OVERLAY_PORTS": "overlays-windows",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE"
            }
        },
        {
            "name": "release",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build_windows",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "WITH_TESTING": "On",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_OVERLAY_TRIPLETS": "custom-triplets",
                "VCPKG_OVERLAY_PORTS": "overlays-windows",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE"
            }
        },
        {
            "name": "release_install",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build_windows",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "WITH_TESTING": "On",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_OVERLAY_TRIPLETS": "custom-triplets",
                "VCPKG_OVERLAY_PORTS": "overlays",
                "VCPKG_TARGET_TRIPLET": "x64-windows",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "TRUE",
                "WITH_BUILD_AGENT_INSTALLER": "On"
            }
        },
        {
            "name": "release_cma_linux",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "WITH_TESTING": "On",
                "COMPILE_ONLY_AGENT": "On",
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_OVERLAY_TRIPLETS": "/custom-triplets",
                "VCPKG_OVERLAY_PORTS": "/overlays-windows",
                "VCPKG_TARGET_TRIPLET": "x64-linux-release"
            }
        }
    ]
}